# ─────────────────────────────────────────────────────────────────────────────
# NailTrace Backend — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=replace-with-a-long-random-string-min-50-chars

# PostgreSQL (matches docker-compose defaults)
POSTGRES_DB=nailtrace
POSTGRES_USER=nailtrace
POSTGRES_PASSWORD=nailtrace
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# ─────────────────────────────────────────────────────────────────────────────
# AWS — S3 private board storage
# Leave blank in dev to skip S3 (boards won't upload but app will run)
# ─────────────────────────────────────────────────────────────────────────────
AWS_REGION=ap-southeast-1
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# PayMongo — payment gateway
# Get keys from: https://dashboard.paymongo.com/developers
# ─────────────────────────────────────────────────────────────────────────────
PAYMONGO_SECRET_KEY=sk_test_
PAYMONGO_PUBLIC_KEY=pk_test_
PAYMONGO_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Production only (leave blank in dev)
# ─────────────────────────────────────────────────────────────────────────────
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=
SENTRY_DSN=
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
