# ─────────────────────────────────────────────────────────────────────────────
# TraceBoard Backend — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored and must NEVER be committed.
#
# In production (ECS), all values are injected from AWS SSM Parameter Store.
# To pull a local copy: bash infra/scripts/sync-env.sh dev
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
ALLOWED_HOSTS=                          # Comma-separated; prod: api.traceboard.app,*.elb.amazonaws.com
CORS_ALLOWED_ORIGINS=                   # Comma-separated; prod: https://traceboard.app
DEFAULT_FROM_EMAIL=noreply@nailtrace.app  # Sender address for all outbound email

# ── Auth / Secrets ────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=replace-with-a-long-random-string-min-50-chars  # MUST change; used for sessions, CSRF, tokens

# ── Build ─────────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev  # Overridden by Dockerfile ENV in production

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
POSTGRES_DB=nailtrace                   # Database name
POSTGRES_HOST=db                        # Hostname (docker-compose service name in dev)
POSTGRES_PASSWORD=nailtrace             # Database password
POSTGRES_PORT=5432                      # Port (default: 5432; Supabase pooler uses 6543)
POSTGRES_USER=nailtrace                 # Database user

# ── Infrastructure / AWS ─────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=                      # ⚠  Not needed in ECS — use IAM task role instead
AWS_REGION=ap-southeast-1              # AWS region for S3 client
AWS_SECRET_ACCESS_KEY=                  # ⚠  Not needed in ECS — use IAM task role instead
AWS_STORAGE_BUCKET_NAME=               # S3 bucket for board files; leave blank in dev to skip S3

# ── PayMongo ──────────────────────────────────────────────────────────────────
PAYMONGO_PUBLIC_KEY=pk_test_            # PayMongo public key (checkout sessions)
PAYMONGO_SECRET_KEY=sk_test_            # PayMongo secret key (API requests)
PAYMONGO_WEBHOOK_SECRET=               # HMAC secret for verifying webhook payloads

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0          # Full redis:// URL; used for cache + Celery broker

# ── Service / Endpoints ───────────────────────────────────────────────────────
EMAIL_HOST=email-smtp.ap-southeast-1.amazonaws.com  # SMTP host (default: AWS SES)
EMAIL_HOST_PASSWORD=                    # SES SMTP password
EMAIL_HOST_USER=                        # SES SMTP username (IAM access key format)
FRONTEND_URL=http://localhost:5173      # FE base URL; used for password-reset links and billing redirects
SENTRY_DSN=                            # Sentry DSN; leave blank to disable error reporting
